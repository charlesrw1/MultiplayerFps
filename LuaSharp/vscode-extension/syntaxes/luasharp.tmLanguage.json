{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "LuaSharp",
  "scopeName": "source.luasharp",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "include": "#members" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "begin": "/\\*", "end": "\\*/", "name": "comment.block.luasharp" },
        { "match": "//.*$", "name": "comment.line.double-slash.luasharp" }
      ]
    },
    "strings": {
      "patterns": [
        { "begin": "\"", "end": "\"", "name": "string.quoted.double.luasharp", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.luasharp" }] },
        { "begin": "'", "end": "'", "name": "string.quoted.single.luasharp", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.luasharp" }] }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(class|struct)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.class.luasharp" },
            "3": { "name": "entity.name.type.class.luasharp" }
          }
        },
        {
          "match": "\\b(enum)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.enum.luasharp" },
            "3": { "name": "entity.name.type.enum.luasharp" }
          }
        }
      ]
    },
    "members": {
      "patterns": [
        { "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()", "name": "entity.name.function.method.luasharp" },
        { "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*", "name": "variable.other.property.luasharp" }
      ]
    },
    "keywords": {
      "patterns": [
        { "match": "\\b(?:public|private|static|virtual|override|abstract|sealed|extern)\\b", "name": "storage.modifier.luasharp" },
        { "match": "\\b(?:if|else|while|for|in|break|continue|return|new|auto)\\b", "name": "keyword.control.luasharp" },
        { "match": "\\b(?:is|as)\\b", "name": "keyword.operator.type.luasharp" },
        { "match": "\\bvoid\\b", "name": "keyword.other.void.luasharp" },
        { "match": "\\b(?:this|base)\\b", "name": "variable.language.this.luasharp" }
      ]
    },
    "types": {
      "patterns": [
        { "match": "\\b(?:int|float|bool|string|table)\\b", "name": "storage.type.primitive.luasharp" }
      ]
    },
    "constants": {
      "patterns": [
        { "match": "\\b(?:true|false|null)\\b", "name": "constant.language.luasharp" }
      ]
    },
    "numbers": {
      "patterns": [
        { "match": "\\b\\d+(?:\\.\\d+)?\\b", "name": "constant.numeric.luasharp" }
      ]
    },
    "operators": {
      "patterns": [
        { "match": "=>|\\.\\.|!=|==|<=|>=|&&|\\|\\||\\+=|-=|\\*=|/=|[+\\-*/%=!<>]", "name": "keyword.operator.luasharp" }
      ]
    }
  }
}
