{
  "name": "luasharp",
  "publisher": "charl",
  "displayName": "LuaSharp",
  "version": "0.1.5",
  "private": true,
  "engines": { "vscode": "^1.95.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:luasharp"],
  "main": "./extension.js",
  "scripts": {
    "test:integration": "node ../test/lsp.integration.test.mjs",
    "test:syntax": "node ../test/syntax-highlighting.test.mjs"
  },
  "contributes": {
    "languages": [{
      "id": "luasharp",
      "aliases": ["LuaSharp", "luasharp"],
      "extensions": [".ls"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "luasharp",
      "scopeName": "source.luasharp",
      "path": "./syntaxes/luasharp.tmLanguage.json"
    }],
    "configuration": {
      "title": "LuaSharp",
      "properties": {
        "luasharp.languageServerPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to LuaSharpLspNative.exe."
        }
      }
    },
    "configurationDefaults": {
      "[luasharp]": { "editor.semanticHighlighting.enabled": true },
      "editor.semanticTokenColorCustomizations": {
        "[*Dark*]": { "rules": { "struct:luasharp": "#86C691" } },
        "[*Light*]": { "rules": { "struct:luasharp": "#2E8B57" } }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
