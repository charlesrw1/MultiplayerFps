{
  "name": "luasharp",
  "displayName": "LuaSharp",
  "version": "0.1.0",
  "private": true,
  "engines": { "vscode": "^1.95.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:luasharp"],
  "main": "./extension.js",
  "contributes": {
    "languages": [{
      "id": "luasharp",
      "aliases": ["LuaSharp", "luasharp"],
      "extensions": [".ls"],
      "configuration": "./language-configuration.json"
    }],
    "configuration": {
      "title": "LuaSharp",
      "properties": {
        "luasharp.languageServerPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to LuaSharpLsp.exe."
        },
        "luasharp.luaLsPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to lua-language-server.exe."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
