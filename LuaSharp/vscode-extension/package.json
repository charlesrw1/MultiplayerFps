{
  "name": "luasharp",
  "publisher": "charl",
  "displayName": "LuaSharp",
  "version": "0.1.9",
  "private": true,
  "engines": { "vscode": "^1.95.0" },
  "categories": ["Programming Languages", "Debuggers"],
  "activationEvents": ["onLanguage:luasharp", "onDebugResolve:luasharp", "onUri"],
  "main": "./extension.js",
  "scripts": {
    "test:integration": "node ../test/lsp.integration.test.mjs",
    "test:syntax": "node ../test/syntax-highlighting.test.mjs"
  },
  "contributes": {
    "languages": [{
      "id": "luasharp",
      "aliases": ["LuaSharp", "luasharp"],
      "extensions": [".ls"],
      "configuration": "./language-configuration.json"
    }],
    "breakpoints": [{ "language": "luasharp" }],
    "debuggers": [{
      "type": "luasharp",
      "label": "LuaSharp",
      "languages": ["luasharp"],
      "configurationAttributes": {
        "attach": {
          "properties": {
            "port": { "type": "number", "default": 4711, "description": "The DAP port: `LuaSharp.exe run <file.ls> --debug --port N`, or the engine with ls_debug." },
            "host": { "type": "string", "default": "127.0.0.1" }
          }
        }
      },
      "initialConfigurations": [{ "type": "luasharp", "request": "attach", "name": "Attach to LuaSharp", "port": 4711 }],
      "configurationSnippets": [{
        "label": "LuaSharp: Attach",
        "description": "Attach to a LuaSharp program or the engine.",
        "body": { "type": "luasharp", "request": "attach", "name": "Attach to LuaSharp", "port": 4711 }
      }]
    }],
    "grammars": [{
      "language": "luasharp",
      "scopeName": "source.luasharp",
      "path": "./syntaxes/luasharp.tmLanguage.json"
    }],
    "configuration": {
      "title": "LuaSharp",
      "properties": {
        "luasharp.languageServerPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to LuaSharpLspNative.exe."
        }
      }
    },
    "configurationDefaults": {
      "[luasharp]": { "editor.semanticHighlighting.enabled": true },
      "editor.semanticTokenColorCustomizations": {
        "[*Dark*]": { "rules": { "struct:luasharp": "#86C691" } },
        "[*Light*]": { "rules": { "struct:luasharp": "#2E8B57" } }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
